# syntax=docker/dockerfile:1
# Ollama with the extraction model already inside, so the stack starts
# without a multi-GB download. The model files are architecture-independent,
# so they're pulled once on the build host and copied into each platform.

FROM --platform=$BUILDPLATFORM ollama/ollama:latest AS pull
ARG MODEL=qwen2.5:7b
RUN (ollama serve > /tmp/serve.log 2>&1 &) \
 && for i in $(seq 1 60); do ollama list > /dev/null 2>&1 && break; sleep 1; done \
 && ollama pull "${MODEL}" \
 && ollama list

FROM ollama/ollama:latest
COPY --from=pull /root/.ollama /root/.ollama
ENV OLLAMA_KEEP_ALIVE=24h \
    OLLAMA_NUM_PARALLEL=1
