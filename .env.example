# Copy to .env and edit. Everything has a working default.

# ── Where the LLM runs ───────────────────────────────────────────────────────
# Mac mini: install Ollama natively (https://ollama.com) — Docker on macOS
# can't use the GPU, native Ollama can. The container reaches it here:
OLLAMA_URL=http://host.docker.internal:11434
# NAS (no native Ollama): uncomment both lines to run Ollama in a container.
# COMPOSE_PROFILES=ollama
# OLLAMA_URL=http://ollama:11434

# Model used to read transcripts. Pulled automatically on first start.
#   qwen2.5:7b  (~5 GB)  default; noticeably better call-type accuracy.
#                        ~2 s/call on Apple Silicon, ~30–60 s on a NAS CPU (fine for ~150 dispatches/day)
#   qwen2.5:3b  (~2 GB)  ~2x faster, but mislabels call types more often
OLLAMA_MODEL=qwen2.5:7b
# Set false to skip the LLM entirely and use keyword rules (less accurate).
# LLM_ENABLED=true

# ── Speech-to-text (faster-whisper) ─────────────────────────────────────────
#   base.en   fastest, misses more street names
#   small.en  default, good accuracy, ~2–6 s per clip on CPU
#   medium.en best, ~3x slower than small.en
WHISPER_MODEL=small.en

# ── Feed ─────────────────────────────────────────────────────────────────────
# Hours of history to pull on first start (OpenMHz keeps roughly a month).
BACKFILL_HOURS=24
# Talkgroups as talkgroup:agency:city-hint (default: the five dispatch channels).
# CHANNELS=1827:Tippecanoe Fire:Lafayette,1833:TEAS EMS:Lafayette,1901:Lafayette FD:Lafayette,2021:West Lafayette FD:West Lafayette,2105:Purdue FD:West Lafayette

# Keep dispatch audio clips on disk (~100 KB each).
KEEP_AUDIO=true

# ── Web ──────────────────────────────────────────────────────────────────────
WEB_PORT=8086
# CARTO basemap key (https://carto.com/basemaps) for the dark/light map style.
# Leave empty to use standard OpenStreetMap tiles.
CARTO_API_KEY=

# Image owner on GitHub Container Registry
GHCR_OWNER=owenwright8
