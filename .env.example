# ── Dispatch Monitor — environment variables ──────────────────────────────────
# Copy this file to .env and edit as needed.
# All values have sensible defaults; you only need to set what differs.

# ── Ollama (LLM extraction) ───────────────────────────────────────────────────
# URL of your Ollama API. host.docker.internal reaches Ollama running on the
# Docker host (Mac/Windows). On Linux with --add-host, it also works.
# For a remote Ollama server, use its IP/hostname instead.
OLLAMA_URL=http://host.docker.internal:11434/api/generate

# Ollama model to use for address/call-type extraction.
# Smaller = faster; larger = more accurate.
#   llama3.2   (~2 GB)  — good balance, recommended
#   mistral    (~4 GB)  — slightly better address parsing
#   llama3.1   (~5 GB)  — best accuracy, needs 16 GB+ RAM
OLLAMA_MODEL=llama3.2

# ── Whisper (speech-to-text) ──────────────────────────────────────────────────
# Model size. Larger models are more accurate but slower and use more RAM.
#   tiny.en    — fastest, lowest accuracy  (~1 GB RAM)
#   base.en    — good balance, recommended (~1 GB RAM)
#   small.en   — better accuracy           (~2 GB RAM)
#   medium.en  — best accuracy             (~5 GB RAM)
WHISPER_MODEL=base.en

# ── Web dashboard port ────────────────────────────────────────────────────────
WEB_PORT=8086

# ── GitHub Container Registry (for Dockge / pre-built image) ─────────────────
# Your GitHub username — used to pull the pre-built image.
# Only needed if you're using the GHCR image instead of building locally.
GHCR_OWNER=your-github-username
