# Optional settings. Copy to .env next to docker-compose.yml and uncomment
# what you want to change. Everything works without this file.
# Most of these can also be changed in the dashboard (Settings), which then
# overrides the value here.

# Password required to save settings in the dashboard. Set it if the
# dashboard is reachable from the internet.
# ADMIN_PASSWORD=

# Which county to monitor: a profile in dispatch/counties/ (tippecanoe, hamilton).
# COUNTY=tippecanoe

# Map style: a CARTO basemap key (https://carto.com/basemaps) gives the
# dark/light map. Without one the map uses standard OpenStreetMap tiles.
# CARTO_API_KEY=

# Port the dashboard is served on.
# WEB_PORT=8086

# AI model that reads the transcripts (downloaded automatically).
#   qwen2.5:7b  (~5 GB)  default; ~2 s per call on a Mac, ~30-60 s on a NAS CPU
#   qwen2.5:3b  (~2 GB)  about 2x faster, but mislabels call types more often
# OLLAMA_MODEL=qwen2.5:7b

# Speech-to-text model: base.en (fastest) / small.en (default) / medium.en (best)
# WHISPER_MODEL=small.en

# Hours of radio history to fetch on first start (OpenMHz keeps about a month).
# BACKFILL_HOURS=24

# Keep dispatch audio clips on disk (~100 KB each).
# KEEP_AUDIO=true
