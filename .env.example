# Optional settings. Copy to .env next to docker-compose.yml and uncomment
# what you want to change. Everything works without this file.
# Most of these can also be changed in the dashboard (Settings), which then
# overrides the value here.

# Password required to save settings in the dashboard. Set it if the
# dashboard is reachable from the internet.
# ADMIN_PASSWORD=

# Which county to monitor: a profile in dispatch/counties/ (tippecanoe, hamilton).
# COUNTY=tippecanoe

# Authorized OpenMHz access. Ask the operator (support@openmhz.com) to allowlist
# this install if Cloudflare challenges it. Any one of these is enough; set them
# and the app identifies as itself instead of impersonating a browser.
#   Cloudflare Access service token (both values):
# OPENMHZ_ACCESS_CLIENT_ID=
# OPENMHZ_ACCESS_CLIENT_SECRET=
#   Bearer token:
# OPENMHZ_TOKEN=
#   Dedicated origin hostname:
# OPENMHZ_API=https://api.openmhz.com
# Put a contact address in the user agent so an allowlist entry can be traced:
# USER_AGENT=tippecanoe-dispatch-monitor/2.1 (you@example.com)

# Map style: a CARTO basemap key (https://carto.com/basemaps) gives the
# dark/light map. Without one the map uses standard OpenStreetMap tiles.
# CARTO_API_KEY=

# Port the dashboard is served on.
# WEB_PORT=8086

# AI model that reads the transcripts (downloaded automatically).
#   qwen2.5:7b  (~5 GB)  default; ~2 s per call on a Mac, ~30-60 s on a NAS CPU
#   qwen2.5:3b  (~2 GB)  about 2x faster, but mislabels call types more often
# OLLAMA_MODEL=qwen2.5:7b

# Speech-to-text on a GPU: a whisper-asr-webservice (e.g. large-v3 on CUDA) hears
# street and department names much better than the built-in CPU model, which
# takes over automatically if the server is unreachable.
# WHISPER_URL=http://whisper-asr:9000

# Speech-to-text model: base.en (fastest) / small.en (default) / medium.en (best)
# WHISPER_MODEL=small.en

# Hours of radio history to fetch on first start (OpenMHz keeps about a month).
# BACKFILL_HOURS=24

# How hard to poll. A quiet feed stretches from POLL_INTERVAL_S towards
# POLL_IDLE_MAX_S, and a gap is walked back POLL_CATCHUP_PAGES pages per poll.
# POLL_INTERVAL_S=30
# POLL_IDLE_MAX_S=300
# POLL_CATCHUP_PAGES=5
# PAGE_DELAY_S=1.0

# Keep dispatch audio clips on disk (~100 KB each).
# KEEP_AUDIO=true
